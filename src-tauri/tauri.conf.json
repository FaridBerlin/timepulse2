{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "timepulse2",
  "identifier": "com.faridberlin.timepulse2",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Timepulse",
        "width": 420,
        "height": 180,
        "minWidth": 260,
        "minHeight": 110,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true,
        "alwaysOnTop": false,
        "skipTaskbar": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Farid",
    "homepage": "https://github.com/FaridBerlin/timepulse2",
    "category": "Utility",
    "shortDescription": "A big, always-readable desktop clock, stopwatch and timer",
    "longDescription": "Timepulse is a large, fully customizable digital clock for the Linux desktop, built to be easy to read from across the room. Pick any color for the digits, choose a solid or fully transparent background, click the clock to reveal a settings panel with a stopwatch and countdown timer, and optionally pin the window always-on-top over every other app.",
    "linux": {
      "deb": {
        "desktopTemplate": "deb/timepulse2.desktop"
      }
    }
  }
}
