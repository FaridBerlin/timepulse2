{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "timepulse2",
  "version": "0.1.0",
  "identifier": "com.faridberlin.timepulse2",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Timepulse",
        "width": 420,
        "height": 180,
        "minWidth": 260,
        "minHeight": 110,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true,
        "alwaysOnTop": false,
        "skipTaskbar": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
